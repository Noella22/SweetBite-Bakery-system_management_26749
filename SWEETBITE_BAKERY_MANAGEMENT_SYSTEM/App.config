<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Local XAMPP/MariaDB development only. Update Password if needed. -->
    <add name="SweetBiteDB"
         connectionString="Server=127.0.0.1;Port=3306;Database=sweetbite_db;User ID=root;Password=;"
         providerName="MySqlConnector" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
